@using EmployeeManager.Models
@model Employee

@{
    // index is provided via ViewData["index"] and may be an int or the placeholder string
    var idx = ViewData["index"]?.ToString() ?? "0";
    var originalPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
    ViewData.TemplateInfo.HtmlFieldPrefix = $"employees[{idx}]";
}

<tr data-employee-row="true">
    <td>
        @Html.HiddenFor(m => m.Id)
        @* Hidden inputs for posting via SaveAll; visible display is a simple span *@
        @Html.HiddenFor(m => m.FullName)
        <div class="form-control-plaintext fullName">@Html.DisplayFor(m => m.FullName)</div>
    </td>
    <td>
        @Html.HiddenFor(m => m.DepartmentId)
        @{ var depts = ViewData["Departments"] as IEnumerable<EmployeeManager.Services.DepartmentItem> ?? Enumerable.Empty<EmployeeManager.Services.DepartmentItem>();
           var deptName = depts.FirstOrDefault(d => d.Id == Model.DepartmentId)?.Name ?? string.Empty; }
        <div class="form-control-plaintext departmentName">@deptName</div>
    </td>
    <td>
        @Html.HiddenFor(m => m.Skill)
        <div class="form-control-plaintext skillValue">@Html.DisplayFor(m => m.Skill)</div>
    </td>
    <td>
        <button class="btn btn-sm btn-secondary edit-btn me-1" data-id="@Model.Id">Edit</button>
        <button class="btn btn-sm btn-danger delete-btn" data-id="@Model.Id">Delete</button>
    </td>
</tr>

@{
    // restore original prefix to avoid affecting parent view
    ViewData.TemplateInfo.HtmlFieldPrefix = originalPrefix;
}
